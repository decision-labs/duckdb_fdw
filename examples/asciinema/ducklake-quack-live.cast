[14.495432, "o", "CREATE EXTENSION\r\r\n\u001b[?2004h"]
[14.495579, "o", "postgres=# "]
[15.347493, "o", "CREATE SERVER lake FOREIGN DATA WRAPPER duckdb_fdw OPTIONS (ducklake_quack_host 'demo-duckdb-1:9494', data_path 's3://demo', s3_endpoint 'rustfs:9000', s3_use_ssl 'false', s3_url_style 'path', disable_ssl 'true');\r\r\n\u001b[?2004l\r"]
[15.357669, "o", "CREATE SERVER\r\r\n"]
