[3.049199, "o", "\\set quack_token `printf %s \"$QUACK_TOKEN\"`\r\r\n\u001b[?2004l\r"]
[3.050227, "o", "\u001b[?2004hpostgres=# "]
[3.251199, "o", "\\set s3_key `printf %s \"$S3_ACCESS_KEY_ID\"`\r\r\n\u001b[?2004l\r"]
[3.252432, "o", "\u001b[?2004hpostgres=# "]
[3.45344, "o", "\\set s3_secret `printf %s \"$S3_SECRET_ACCESS_KEY\"`\r\r\n\u001b[?2004l\r"]
[3.454698, "o", "\u001b[?2004hpostgres=# "]
[3.656303, "o", "CREATE USER MAPPING FOR CURRENT_USER SERVER lake OPTIONS (quack_token :'quack_token', s3_access_key_id :'s3_key', s3_secret_access_key :'s3_secret');\r\r\n\u001b[?2004l\r"]
[3.666827, "o", "CREATE USER MAPPING\r\r\n\u001b[?2004hpostgres=# "]
[3.867819, "o", "CREATE SCHEMA IF NOT EXISTS remote_lake;\r\r\n\u001b[?2004l\r"]
[3.868316, "o", "NOTICE:  schema \"remote_lake\" already exists, skipping\r\r\nCREATE SCHEMA\r\r\n\u001b[?2004hpostgres=# "]
[4.069266, "o", "IMPORT FOREIGN SCHEMA main FROM SERVER lake INTO remote_lake;\r\r\n\u001b[?2004l\r"]
[4.194014, "o", "IMPORT FOREIGN SCHEMA\r\r\n"]
[4.194193, "o", "\u001b[?2004hpostgres=# "]
[4.394894, "o", "\\det remote_lake.*\r\r\n\u001b[?2004l\r"]
[4.396639, "o", "     List of foreign tables\r\r\n   Schema    |  Table   | Server \r\r\n-------------+----------+--------\r\r\n remote_lake | airports | lake\r\r\n remote_lake | fdw_demo | lake\r\r\n(2 rows)\r\r\n\r\r\n"]
[4.396838, "o", "\u001b[?2004hpostgres=# "]
[4.597727, "o", "SELECT * FROM remote_lake.fdw_demo ORDER BY id;\r\r\n\u001b[?2004l\r"]
[4.708794, "o", " id |      name      \r\r\n----+----------------\r\r\n  1 | postgres\r\r\n  2 | ducklake\r\r\n  3 | quack\r\r\n  4 | fdw-write\r\r\n  5 | geobase\r\r\n  6 | rustfs\r\r\n  7 | asciinema-demo\r\r\n(7 rows)\r\r\n\r\r\n"]
[4.708969, "o", "\u001b[?2004hpostgres=# "]
