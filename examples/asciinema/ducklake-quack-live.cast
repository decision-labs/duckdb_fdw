[17.316813, "o", "\u001b[?2004hpostgres=# "]
[17.668682, "o", "CREATE USER MAPPING FOR CURRENT_USER SERVER lake OPTIONS (quack_token :'quack_token', s3_access_key_id :'s3_key', s3_secret_access_key :'s3_secret');\r\r\n\u001b[?2004l\r"]
[17.679038, "o", "CREATE USER MAPPING\r\r\n\u001b[?2004hpostgres=# "]
